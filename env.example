# Remote adapter environment — SET THESE ON THE REMOTE MACHINE.
# Never commit the real values; the pack's opencode.json reads them through
# OpenCode's {env:VAR} substitution.
#
# The base URL of the tunnel that reaches the HOST bridge (no trailing /mcp —
# the pack appends it).
PIPELINE_BRIDGE_URL=https://example.ngrok-free.app
#
# The shared secret. Must equal PIPELINE_BRIDGE_TOKEN on the host.
PIPELINE_BRIDGE_TOKEN=paste-the-host-token-here
